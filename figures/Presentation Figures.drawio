        </mxCell>
        <mxCell id="Sc86Al-la38u0nAGnfyo-2" value="&lt;font style=&quot;font-size: 15px&quot;&gt;Summary and Description were most used textual features from bug report document. Text mining methods played a importante role.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#4D4D4D;" parent="-7tM4FVGBPYI5Kkq3Ckx-1" vertex="1">
          <mxGeometry x="563" y="158" width="290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Sc86Al-la38u0nAGnfyo-5" value="&lt;font style=&quot;font-size: 15px&quot;&gt;TF-IDF was the most used vector weighting &lt;br&gt;model for feature extraction. Terms ranged from 25 to 125. Many papers did not mention this information.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#4D4D4D;" parent="-7tM4FVGBPYI5Kkq3Ckx-1" vertex="1">
          <mxGeometry x="651" y="500" width="299" height="30" as="geometry" />
        </mxCell>
      </root>
